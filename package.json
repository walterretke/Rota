{
  "name": "rota",
  "private": true,
  "version": "0.1.0",
  "description": "Rota: análise de ranqueada para League of Legends (app desktop Windows)",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:web": "vite",
    "build:web": "tsc --noEmit && vite build",
    "test": "vitest run && cargo test --manifest-path src/main/Cargo.toml",
    "lint": "eslint . && cargo clippy --manifest-path src/main/Cargo.toml --all-targets -- -D warnings",
    "typecheck": "tsc --noEmit && cargo check --manifest-path src/main/Cargo.toml --all-targets",
    "icons": "tauri icon src/main/app-icon.png"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
